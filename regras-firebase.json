{
  "rules": {
    "guepar": {
      ".read": "!root.child('guepar_meta').exists() || (auth != null && root.child('guepar_papeis').child(auth.uid).val() === 'admin')",
      ".write": false
    },
    "guepar_meta": {
      ".read": true,
      ".write": "auth != null && root.child('guepar_papeis').child(auth.uid).val() === 'admin'"
    },
    "guepar_logins": {
      "$k": { ".read": true },
      ".write": "auth != null && root.child('guepar_papeis').child(auth.uid).val() === 'admin'"
    },
    "guepar_papeis": {
      ".read": "auth != null && root.child('guepar_papeis').child(auth.uid).val() === 'admin'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (root.child('guepar_papeis').child(auth.uid).val() === 'admin' || (!root.child('guepar_meta').exists() && auth.uid === $uid && newData.val() === 'admin'))",
        ".validate": "newData.isString() && (newData.val() === 'admin' || newData.val() === 'visitante1' || newData.val() === 'visitante')"
      }
    },
    "guepar_usuarios": {
      ".read": "auth != null && root.child('guepar_papeis').child(auth.uid).val() === 'admin'",
      ".write": "auth != null && root.child('guepar_papeis').child(auth.uid).val() === 'admin'"
    },
    "guepar_pins": {
      ".read": "auth != null && root.child('guepar_papeis').child(auth.uid).val() === 'admin'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('guepar_papeis').child(auth.uid).val() === 'admin'"
      }
    },
    "guepar2": {
      ".read": "auth != null && root.child('guepar_papeis').child(auth.uid).exists()",
      "$col": {
        ".write": "auth != null && (root.child('guepar_papeis').child(auth.uid).val() === 'admin' || root.child('guepar_papeis').child(auth.uid).val() === 'visitante1' || ($col === 'logs' && root.child('guepar_papeis').child(auth.uid).exists()))"
      }
    },
    "guepar_fotos": {
      ".read": "auth != null && root.child('guepar_papeis').child(auth.uid).exists()",
      "$h": {
        ".write": "auth != null && (root.child('guepar_papeis').child(auth.uid).val() === 'admin' || root.child('guepar_papeis').child(auth.uid).val() === 'visitante1')"
      }
    }
  }
}
